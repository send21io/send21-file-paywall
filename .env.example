# Leave SEND21_API_KEY empty to run the whole loop locally (mock send21,
# sample files, a pay simulator). No keys needed.

# --- send21 (https://send21.io/api-keys, scope drafts:write; + webhooks:manage to register) ---
SEND21_API_KEY=
# Printed once by `npm run webhook:register`.
SEND21_WEBHOOK_SECRET=
# Where this server is reachable from the internet (https in production).
PUBLIC_URL=http://localhost:3000

# --- Where you get paid: YOUR own addresses (coin ids in src/currencies.ts) ---
PAY_LIGHTNING=
PAY_OPTIONS=usdc-sol:<your Solana address>,usdt-sol:<your Solana address>

# --- Secrets (openssl rand -hex 32) ---
# Signs download tokens. Required with a real key.
DOWNLOAD_SECRET=
# Opens /seller. Required with a real key (24+ characters).
SELLER_TOKEN=

# --- Files ---
# Private folder with the files. NOT public/. Add files with `npm run file:add`.
FILES_DIR=./files
# PAYWALL_FILE=./paywall.json

# --- Rules ---
PAY_EXPIRY_HOURS=1
SHORTFALL_PERCENT=0
DOWNLOAD_TTL_SECONDS=300
DOWNLOAD_LIMIT=5
PORT=3000
DATA_FILE=./data/paywall.json
# TRUST_PROXY=1
